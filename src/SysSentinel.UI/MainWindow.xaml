<Window x:Class="SysSentinel.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysSentinel - System Guard &amp; Resource Orchestrator"
        Width="900" Height="540" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SysSentinel" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ListBox Grid.Row="1" Margin="0,12" ItemsSource="{Binding Profiles}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="  ● ACTIVE" Foreground="SeaGreen"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="DimGray" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PowerPlanGuid, StringFormat=Power plan: {0}}"
                                   Foreground="Gray" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Tải lại" Width="100" HorizontalAlignment="Left"
                Command="{Binding LoadCommand}" />
    </Grid>
</Window>
